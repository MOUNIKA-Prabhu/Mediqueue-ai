# ---- Database (MongoDB / MongoDB Compass / Atlas) ----
DATABASE_URL="mongodb://localhost:27017/mediqueue"

# ---- Clerk Authentication (Admin panel only) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/admin/login"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/admin"

# ---- Gemini AI (symptom -> department recommendation) ----
# If left blank, the app automatically falls back to the built-in
# English/Tamil/Tanglish keyword matcher in src/lib/symptom-fallback.ts
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ---- UPI Payment ----
HOSPITAL_UPI_ID="mediqueue@upi"
HOSPITAL_NAME="MediQueue General Hospital"

# ---- Doctor Availability Credentials ----
DOCTOR_AVAIL_DEFAULT_USERNAME=doctor
DOCTOR_AVAIL_DEFAULT_PASSWORD=doctor123
